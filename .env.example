# ─── Crunchy Gherkins TCG Docker Environment ─────────────────────────────
# Copy this file to .env and fill in your values.
# This file is used by compose.yaml (and its overlays) via env_file.

# ─── Compose overlay ────────────────────────────────────────────────
# Optional deployment override.
# Leave unset for local development using compose.yaml.
#
# GCP:
# COMPOSE_FILE=compose.yaml:compose.gcp.yaml
#
# Self-hosted:
# COMPOSE_FILE=compose.yaml:compose.selfhosted.yaml

# ─── Database ────────────────────────────────────────────────────────

# PostgreSQL container settings used by compose.selfhosted.yaml
POSTGRES_DB=gacha
POSTGRES_USER=gacha
POSTGRES_PASSWORD=replace-with-a-secure-password

# Self-hosted Compose deployment (postgres service in compose.selfhosted.yaml)
DATABASE_URL=postgresql+psycopg://gacha:replace-with-a-secure-password@postgres:5432/gacha

# GCP deployment through Cloud SQL Auth Proxy
# DATABASE_URL=postgresql+psycopg://gacha:PASSWORD@cloud-sql-proxy:5432/gacha
# CLOUD_SQL_CONNECTION_NAME=project:region:instance

# ─── Telegram Bot ────────────────────────────────────────────────────
TELEGRAM_AUTH_TOKEN=your-bot-token-here
# Debug mode vars (used when DEBUG_MODE=1):
# DEBUG_MODE=1
# DEBUG_TELEGRAM_AUTH_TOKEN=your-debug-bot-token-here
# DEBUG_BOT_ADMIN=your-telegram-username
# DEBUG_MINIAPP_URL=https://your-ngrok-url.ngrok-free.app

# ─── Telegram Bot API Server ────────────────────────────────────────
# Required for the tg-bot-api container (get from https://my.telegram.org)
TELEGRAM_API_ID=your-api-id
TELEGRAM_API_HASH=your-api-hash

# ─── Google Gemini (AI image generation) ─────────────────────────────
GOOGLE_API_KEY=your-google-api-key
IMAGE_GEN_MODEL=gemini-2.0-flash-preview-image-generation

# ─── Bot Configuration ──────────────────────────────────────────────
BOT_ADMIN=your-telegram-username
CURRENT_SEASON=2
MINIAPP_URL=https://app.crunchygherkins.com

# ─── API Server ─────────────────────────────────────────────────────
SERVER_SECRET=generate-a-random-secret-here
# CORS_ORIGINS=https://app.crunchygherkins.com,https://admin.crunchygherkins.com,http://localhost:5173
# VITE_API_BASE_URL=  (set if frontend needs a custom API URL; nginx proxies /api/ by default)

# Admin dashboard session cookie. Defaults to Secure=true in production
# (DEBUG_MODE=false). For local dev over plain http, set to false so the
# browser will actually store the cookie.
# ADMIN_COOKIE_SECURE=false
# ADMIN_COOKIE_SAMESITE=lax

# ─── Redis (ephemeral state store) ──────────────────────────────────
# Required. Used for short-lived, TTL-keyed data (handshake tokens, rate
# limits, etc.). Process refuses to start if this is unset.
#   - Native local dev (Homebrew Redis): redis://localhost:6379/0
#   - Docker Compose (bundled redis service): redis://redis:6379/0
#   - Managed Redis (e.g. GCP Memorystore): rediss://user:pass@host:port/0
REDIS_URL=redis://redis:6379/0

# ─── Optional ────────────────────────────────────────────────────────
# DEBUG_MODE=1                         # Enable debug mode
# NO_GENERATION=1                      # Disable AI image generation (debug only)
# DB_CONNECTION_POOL_SIZE=6            # SQLAlchemy pool size
# DB_CONNECTION_TIMEOUT_SECONDS=30     # SQLAlchemy connection timeout
# SHADOW_STAGGERED_USERNAMES=          # Comma-separated usernames for artificial delays
